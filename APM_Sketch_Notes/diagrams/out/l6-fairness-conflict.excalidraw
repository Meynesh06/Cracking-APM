   "isDeleted": false,
   "boundElements": null,
   "updated": 1793728600941,
   "link": null,
   "locked": false,
   "text": "generative AI adds representational harms: stereotyped images,\nunequal quality across languages, toxic outputs about groups.\ntest prompts across groups and languages, not just accuracy.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b8",
   "originalText": "generative AI adds representational harms: stereotyped images,\nunequal quality across languages, toxic outputs about groups.\ntest prompts across groups and languages, not just accuracy.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "AODCr2fEF-r6YXqpBYPfA",
   "type": "text",
   "x": 255.78013610839844,
   "y": 503.25,
   "width": 448.4397277832031,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
