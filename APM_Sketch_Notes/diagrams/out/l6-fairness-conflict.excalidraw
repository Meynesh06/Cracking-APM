   "boundElements": null,
   "updated": 1793728600941,
   "link": null,
   "locked": false,
   "text": "when base rates differ, a model generally cannot\nmeet calibration and equal error rates at once\nin general (the COMPAS debate, 2016)",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b6",
   "originalText": "when base rates differ, a model generally cannot\nmeet calibration and equal error rates at once\nin general (the COMPAS debate, 2016)",
