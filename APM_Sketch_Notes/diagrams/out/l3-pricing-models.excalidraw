   "boundElements": null,
   "updated": 1793728469906,
   "link": null,
   "locked": false,
   "text": "usage-based\ncharges: tokens, requests,\ndocuments, minutes\ngood when: cost tracks usage closely\nrisk: hard to budget; churn when\nbills spike",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b4",
   "originalText": "usage-based\ncharges: tokens, requests,\ndocuments, minutes\ngood when: cost tracks usage closely\nrisk: hard to budget; churn when\nbills spike",
   "autoResize": true,
   "lineHeight": 1.25
  },
