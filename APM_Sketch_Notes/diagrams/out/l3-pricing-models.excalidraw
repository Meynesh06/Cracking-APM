   "text": "per seat\ncharges: users per month\ngood when: value tracks headcount\nrisk: heavy users cost more than\nthe seat price; light users underpay",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b3",
   "originalText": "per seat\ncharges: users per month\ngood when: value tracks headcount\nrisk: heavy users cost more than\nthe seat price; light users underpay",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
