   "isDeleted": false,
   "boundElements": null,
   "updated": 1793728469884,
   "link": null,
   "locked": false,
   "text": "test: remove the model vendor.\nWhat is left that a customer would\nmiss? If only the prompt, the moat\nis weak.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b4",
   "originalText": "test: remove the model vendor.\nWhat is left that a customer would\nmiss? If only the prompt, the moat\nis weak.",
