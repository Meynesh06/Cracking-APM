[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Pricing: willingness to pay first, then the range", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "cost sets the floor; the substitute and the value set the ceiling", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 20, "y": 100, "width": 300, "height": 40, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "1. Clarify", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t4", "x": 338, "y": 111.0, "text": "buyer, product, new category or a competitive one", "fontSize": 15, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b5", "x": 34, "y": 148, "width": 300, "height": 40, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "2. Willingness to pay", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t6", "x": 352, "y": 159.0, "text": "value to the customer, or rival price + gap", "fontSize": 15, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b7", "x": 48, "y": 196, "width": 300, "height": 40, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "3. Cost floor", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t8", "x": 366, "y": 207.0, "text": "unit cost; cost-plus is a sanity check only", "fontSize": 15, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b9", "x": 62, "y"