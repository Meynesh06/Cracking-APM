[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "The feedback loop, designed on purpose", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "react, learn, change, and close the loop where you can", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 20, "y": 96, "width": 210, "height": 64, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "users react", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 255, "y": 96, "width": 210, "height": 64, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "signals: explicit,\nimplicit, expert", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 490, "y": 96, "width": 210, "height": 64, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "triage queue with\nan owner and a time", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 725, "y": 96, "width": 210, "height": 64, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "product changes;\nclose the loop visibly", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "arrow", "id": "a7", "x": 230, "y": 128, "width": 25, "height": 0, "points": [[0, 0], [25, 0]], "strokeColor": "#868e96", "strokeWidth": 2, "endArrowhead": "arrow", "startArrowhead": null}, {"type": "arrow", "id": "a8", "x": 465, "y": 128, "width": 25, "height": 0, "points": [[0, 0], [25, 0]], "strokeColor": "#868e96", "strokeWidth": 2, "endArrowhead": "arrow", "startArrowhead": null}, {"type": "arrow", "id": "a9", "x": 700, "y": 128, "width": 25, "height": 0, "points": [[0, 0], [25, 0]], "strokeColor": "#868e96", "strokeWidth": 2, "endArrowhead": "arrow", "startArrowhead": null}, {"type": "rectangle", "id": "b10", "x": 20, "y": 186, "width": 300, "height": 150, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "explicit (sparse, clear)\nthumbs up or down\nreport a problem, star ratings\ncorrections typed by the user", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b11", "x": 330, "y": 186, "width": 300, "height": 150, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "implicit (abundant, noisy)\nedits to an AI draft, copy or accept\nregenerate clicks, abandonment\nescalation to a human", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b12", "x": 640, "y": 186, "width": 300, "height": 150, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "expert (trained reviewers)\nlabels on sampled outputs\nsee Chapter 8.2", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b13", "x": 20, "y": 354, "width": 920, "height": 40, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "use both signals, and check that they agree", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b14", "x": 20, "y": 406, "width": 920, "height": 74, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "pitfalls: heavy and angry users over-represent;\nweight by segment. A thumbs-down may mean tone,\nnot a wrong answer. Feedback is not ground truth.", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]