[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Tokens set the cost; the context window sets the limit", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "a big window is a limit on what one call can read, not memory", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 0, "y": 84, "width": 440, "height": 84, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "1 token is about 4 characters,\nor about three-quarters of a word.\n1,000 tokens is about 750 words.", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 500, "y": 84, "width": 460, "height": 84, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "input and output billed separately\nper million tokens; output often costs\nmore. Prices fall: date every quote.", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t5", "x": 0, "y": 190, "text": "context window: all input plus output in one call", "fontSize": 18, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "rectangle", "id": "b6", "x": 0, "y": 226, "width": 150, "height": 56, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "system prompt", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 150, "y": 226, "width": 190, "height": 56, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "chat history", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 340, "y": 226, "width": 300, "height": 56, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "retrieved text", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b9", "x": 640, "y": 226, "width": 120, "height": 56, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "question", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b10", "x": 760, "y": 226, "width": 200, "height": 56, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "answer room", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "arrow", "id": "a11", "x": 400, "y": 290, "width": 200, "height": 0, "points": [[0, 0], [200, 0]], "strokeColor": "#e03131", "strokeWidth": 3, "endArrowhead": null, "startArrowhead": null}, {"type": "text", "id": "t12", "x": 400, "y": 298, "text": "lost in the middle: facts here get missed", "fontSize": 15, "fontFamily": 5, "strokeColor": "#e03131", "textAlign": "left"}, {"type": "rectangle", "id": "b13", "x": 0, "y": 336, "width": 310, "height": 96, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "you pay for every input token\non every call: a long context\nis a recurring cost", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b14", "x": 325, "y": 336, "width": 310, "height": 96, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "no memory between calls.\nchat memory is history or saved\nfacts re-sent inside the window", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b15", "x": 650, "y": 336, "width": 310, "height": 96, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "quality can drop for facts buried\nin the middle of a very long window\nso test with real documents", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b16", "x": 0, "y": 452, "width": 960, "height": 40, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "prompts are product code: version them, test them, monitor them", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]