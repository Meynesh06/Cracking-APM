[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Design the failure path as carefully as the success path", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "five layers, each one a product decision, then the error classes", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 0, "y": 96, "width": 170, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "1 Prevent", "fontSize": 17, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 180, "y": 96, "width": 780, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 18, "roundness": {"type": 3}, "label": {"text": "ground answers in retrieved sources (RAG)\nconstrain outputs to known schemas; abstain if unsourced", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 0, "y": 162, "width": 170, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "2 Detect", "fontSize": 17, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 180, "y": 162, "width": 780, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 18, "roundness": {"type": 3}, "label": {"text": "run checks before output reaches the user\ncitation checks, schema checks, rules, a second model as judge", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 0, "y": 228, "width": 170, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "3 Signal", "fontSize": 17, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 180, "y": 228, "width": 780, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 18, "roundness": {"type": 3}, "label": {"text": "tell users when the answer is uncertain,\nunsourced or partial", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b9", "x": 0, "y": 294, "width": 170, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "4 Recover", "fontSize": 17, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b10", "x": 180, "y": 294, "width": 780, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 18, "roundness": {"type": 3}, "label": {"text": "offer a fast path: edit, ask again, escalate to a human,\nor open the source", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b11", "x": 0, "y": 360, "width": 170, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "5 Learn", "fontSize": 17, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b12", "x": 180, "y": 360, "width": 780, "height": 58, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 18, "roundness": {"type": 3}, "label": {"text": "log user corrections and reports as labelled data for evals", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t13", "x": 0, "y": 428, "text": "error classes to design for: what the user sees, what the system does, what is logged", "fontSize": 15, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b14", "x": 0, "y": 452, "width": 182, "height": 58, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "factual error", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b15", "x": 192, "y": 452, "width": 182, "height": 58, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "refusal or\nover-refusal", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b16", "x": 384, "y": 452, "width": 182, "height": 58, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "incomplete or\ntruncated", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b17", "x": 576, "y": 452, "width": 182, "height": 58, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "latency timeout\nor tool failure", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b18", "x": 768, "y": 452, "width": 182, "height": 58, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "harmful or\noff-brand", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]