[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Copilot, automation, agent: one dial, three postures", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "more AI action alone: more value, more risk, more evals", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "text", "id": "t3", "x": 40, "y": 66, "text": "autonomy rises from left to right", "fontSize": 15, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "arrow", "id": "a4", "x": 40, "y": 100, "width": 890, "height": 0, "points": [[0, 0], [890, 0]], "strokeColor": "#e8590c", "strokeWidth": 3, "endArrowhead": "arrow", "startArrowhead": null}, {"type": "rectangle", "id": "b5", "x": 40, "y": 118, "width": 280, "height": 196, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "copilot (assistive)\nwho: a human; AI suggests\nexample: drafts, code completion,\nsuggested replies\nrisk: low; the human checks", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 340, "y": 118, "width": 280, "height": 196, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "automation (rules + AI)\nwho: AI runs one bounded step\nexample: auto-tags and routes\ntickets and claims\nrisk: medium; errors repeat\nat scale, easy to reverse", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 640, "y": 118, "width": 280, "height": 196, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "autonomous agent\nwho: AI plans and executes steps\nexample: books, files, resolves\nend to end, with tools\nrisk: high; wrong actions have\nreal consequences", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t8", "x": 0, "y": 326, "text": "decision rule: start at the lowest autonomy that works", "fontSize": 17, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "rectangle", "id": "b9", "x": 0, "y": 354, "width": 960, "height": 36, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "earn the right: log accept and edit rates, widen scope", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b10", "x": 0, "y": 398, "width": 960, "height": 36, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "approval gates on every irreversible step (payments, emails)", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b11", "x": 0, "y": 442, "width": 960, "height": 36, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "analogy: Waymo runs driverless robotaxis in limited areas", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b12", "x": 0, "y": 486, "width": 960, "height": 36, "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeColor": "#868e96", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "moving right: from acceptance and edit rate to task success", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]