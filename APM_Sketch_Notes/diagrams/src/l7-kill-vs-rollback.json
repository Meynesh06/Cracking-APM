[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Kill switch vs rollback: two different tools", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "the kill switch stops the AI path; rollback swaps the version", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 20, "y": 96, "width": 460, "height": 210, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "kill switch\nturns the AI path off, in minutes\nno redeploy\nfalls back to: the old non-AI flow, a cached\nanswer, or \"temporarily unavailable\"\nuse for any incident", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 500, "y": 96, "width": 440, "height": 210, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "rollback\nreturns to the previous model, prompt or index\nthe feature stays on\nuse when the new version regressed and\nthe old one was fine", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 20, "y": 326, "width": 920, "height": 84, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "version all four, so each one can roll back on its own:\nthe model, the prompt, the retrieval index, the data pipeline", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 20, "y": 424, "width": 920, "height": 40, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "who owns the switch at 2 a.m.? is the runbook written?", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t7", "x": 20, "y": 488, "text": "a switch never flipped in staging is a hope, not a control", "fontSize": 16, "fontFamily": 5, "strokeColor": "#e03131", "textAlign": "left"}]