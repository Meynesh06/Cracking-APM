[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "A user story and its acceptance criteria", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "the \"so that\" ties the work to a real need; criteria say done", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 20, "y": 96, "width": 920, "height": 66, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "As a commuter, I want to save a payment card,\nso that I can pay in one tap next time.", "fontSize": 17, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t4", "x": 20, "y": 176, "text": "acceptance criteria (Given / When / Then):", "fontSize": 16, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "rectangle", "id": "b5", "x": 20, "y": 204, "width": 920, "height": 42, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "Given I have added a card, when I select \"Save\", then it is in my wallet.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 20, "y": 254, "width": 920, "height": 42, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "Given the card is saved, when I open checkout, then it is pre-selected.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 20, "y": 304, "width": 920, "height": 42, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "G