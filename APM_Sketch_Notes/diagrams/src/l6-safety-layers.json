[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Safety: five layers of defence", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "the content policy is written first; the layers enforce it", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 40, "y": 96, "width": 540, "height": 54, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "1 model training: refuse or safely complete risky requests", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 40, "y": 162, "width": 540, "height": 54, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "2 input filters: classify prompts by policy category", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 40, "y": 228, "width": 540, "height": 54, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "3 output filters: check responses before display", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 40, "y": 294, "width": 540, "height": 54, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "4 product design: limit tools, rate limits, account signals", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 40, "y": 360, "width": 540, "height": 54, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "5 human review and escalation: borderline, high severity", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 620, "y": 96, "width": 320, "height": 252, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "misuse: a user deliberately\nseeks harm, e.g. jailbreaks\n\nfailure: a normal request\ngets bad behaviour, e.g. a\nwrong medical dosage\n\nboth need controls; the controls differ", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b9", "x": 20, "y": 436, "width": 920, "height": 46, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "red-team before launch and on a schedule; turn findings into tests", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b10", "x": 20, "y": 494, "width": 920, "height": 46, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "tiered replies: crisis resources for self-harm; decline and offer an alternative", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t11", "x": 20, "y": 552, "text": "a policy with examples of allowed and disallowed requests", "fontSize": 15, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}]