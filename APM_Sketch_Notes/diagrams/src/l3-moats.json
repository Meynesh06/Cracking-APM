[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Defensibility: a wrapper around a model is not a moat", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "what a customer would miss if the vendor vanished", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 0, "y": 84, "width": 300, "height": 120, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "model quality is commoditising:\ncapability becomes cheap and common\nso a wrapper is not a moat", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 0, "y": 222, "width": 300, "height": 128, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "test: remove the model vendor.\nWhat is left that a customer would\nmiss? If only the prompt, the moat\nis weak.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 330, "y": 84, "width": 300, "height": 92, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "proprietary data\nunique, consented, labelled data\nused to improve outcomes", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 660, "y": 84, "width": 300, "height": 92, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "distribution\nan existing user base or channel\n(messaging app, checkout)", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 330, "y": 186, "width": 300, "height": 92, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "workflow integration\nsits in the system of record\nremoving it breaks daily work", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 660, "y": 186, "width": 300, "height": 92, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "switching costs\ndata gravity, retrained teams,\nintegrations and contracts", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b9", "x": 330, "y": 288, "width": 300, "height": 92, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "trust and brand\nslow to copy in regulated or\nhigh-stakes domains", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b10", "x": 660, "y": 288, "width": 300, "height": 92, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "cost position\na lower cost per task lets you\nprice below rivals and earn margin", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b11", "x": 0, "y": 400, "width": 960, "height": 40, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "Bloomberg: data and the Terminal workflow, not the model", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b12", "x": 0, "y":