[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Chapter 5 on one page: the vocabulary to scope AI work", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "the goal is to ask the right questions, not to build models", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 10, "y": 84, "width": 230, "height": 56, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "5.1-5.2 AI and learning types", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 10, "y": 150, "width": 230, "height": 186, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "AI > ML > DL > GenAI\nlabels, no labels, rewards\nLLM pipeline: pre-train, SFT,\npreference tuning, reasoning RL", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 10, "y": 346, "width": 230, "height": 60, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "could rules or a simple\nmodel solve 80% of it?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 250, "y": 84, "width": 230, "height": 56, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "5.3-5.4 lifecycle, LLM basics", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 250, "y": 150, "width": 230, "height": 186, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "ML lifecycle: 7 stages\nmost time on data and\nmonitoring\ntokens drive cost\ncontext is not memory\ntemperature: consistency", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 250, "y": 346, "width": 230, "height": 60, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "can you say what happens\nwhen the model is wrong?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b9", "x": 490, "y": 84, "width": 230, "height": 56, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "5.5 RAG, fine-tuning, embeddings", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b10", "x": 490, "y": 150, "width": 230, "height": 186, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "prompting first\nRAG for facts that change\nfine-tuning for behaviour\nembeddings: search by meaning\nRAG and fine-tuning combine", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b11", "x": 490, "y": 346, "width": 230, "height": 60, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "what changes weekly?\nthen RAG, not training", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b12", "x": 730, "y": 84, "width": 230, "height": 56, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "5.6-5.7 agents, CV, speech, recs", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b13", "x": 730, "y": 150, "width": 230, "height": 186, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "errors compound per step\napproval gates, irreversible steps\nCV: test on real cameras\nspeech: test accent, noise\nrecs: pick, rank, re-rank", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b14", "x": 730, "y": 346, "width": 230, "height": 60, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "what does one error cost,\nand who notices?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b15", "x": 10, "y": 420, "width": 940, "height": 40, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "good outcome: start simple, justify each step up, test on the real segments", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b16", "x": 10, "y": 470, "width": 940, "height": 36, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "the same question for every AI feature: what is the data, the loop, the cost?", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]