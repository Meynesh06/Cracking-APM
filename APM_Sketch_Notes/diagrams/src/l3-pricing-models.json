[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Six ways to charge for AI, each tied to cost or value", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "price on the metric that moves with value and with cost", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 0, "y": 84, "width": 300, "height": 180, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "per seat\ncharges: users per month\ngood when: value tracks headcount\nrisk: heavy users cost more than\nthe seat price; light users underpay", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 330, "y": 84, "width": 300, "height": 180, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "usage-based\ncharges: tokens, requests,\ndocuments, minutes\ngood when: cost tracks usage closely\nrisk: hard to budget; churn when\nbills spike", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 660, "y": 84, "width": 300, "height": 180, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "outcome-based\ncharges: a successful task or\nresolution\ngood when: the outcome is measurable\nrisk: needs trustworthy attribution;\nrevenue volatile", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 0, "y": 282, "width": 300, "height": 180, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "credits\ncharges: prepaid credits spent on\ndifferent AI actions\ngood when: many features with\ndifferent costs\nrisk: opaque to buyers;\ncredit inflation", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 330, "y": 282, "width": 300, "height": 180, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "bundled\ncharges: included in a higher plan\nor suite\ngood when: drives upgrades; raises\nperceived value\nrisk: hides AI cost; hard to\nprice-discriminate", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 660, "y": 282, "width": 300, "height": 180, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "hybrid\ncharges: seat fee + usage credits\ngood when: most enterprise AI deals\nrisk: more complex to explain", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b9", "x": 0, "y": 480, "width": 960, "height": 56, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "price on the metric closest to value and cost\ninclude a usage allowance; charge overage above it", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]