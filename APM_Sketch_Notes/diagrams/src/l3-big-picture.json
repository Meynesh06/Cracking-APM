[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Chapter 6 on one page: price and design against cost", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "model cost is a variable cost of goods sold, from day one", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 10, "y": 84, "width": 230, "height": 56, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "6.1 build, buy or API", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 10, "y": 150, "width": 230, "height": 186, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "start with an API to learn\nmove down the stack only if\ncost, control or data push\nroute narrow, high-volume\ntasks to a smaller model", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 10, "y": 346, "width": 230, "height": 60, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "would you build, host or\ncall an API? why?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 250, "y": 84, "width": 230, "height": 56, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "6.2 unit economics", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 250, "y": 150, "width": 230, "height": 186, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "cost per successful task,\nnot cost per call\ntokens x calls + retries\ngross margin: revenue minus\ncost to serve\ntest tokens, price and use", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 250, "y": 346, "width": 230, "height": 60, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "is it profitable at the\n95th-percentile user?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b9", "x": 490, "y": 84, "width": 230, "height": 56, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "6.3-6.4 pricing and moats", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b10", "x": 490, "y": 150, "width": 230, "height": 186, "backgroundColor": "#eebefa", "fillStyle": "solid", "strokeColor": "#9c36b5", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "six pricing models; a mix\nis common\nprice on value and cost\nmoats: data, distribution,\nworkflow, switching costs", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b11", "x": 490, "y": 346, "width": 230, "height": 60, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "what does the user pay for,\nand what can rivals copy?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b12", "x": 730, "y": 84, "width": 230, "height": 56, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "6.5 autonomy", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b13", "x": 730, "y": 150, "width": 230, "height": 186, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "copilot: a human decides\nautomation: bounded steps\nagent: plans and acts\nmore autonomy, more risk\nearn the right; gate the\nirreversible steps", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b14", "x": 730, "y": 346, "width": 230, "height": 60, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "what does an error cost,\nand who approves the action?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b15", "x": 10, "y": 420, "width": 940, "height": 40, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "good outcome: a margin that holds at peak usage, with a moat", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b16", "x": 10, "y": 470, "width": 940, "height": 36, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 30, "roundness": {"type": 3}, "label": {"text": "the question for every AI feature: what does one task cost?", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]