[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Consent for three uses: default to the narrowest", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "ask for each use separately; never train on prompts without opt-in", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 20, "y": 96, "width": 560, "height": 56, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "a. improve the product for this user (narrowest, default)", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 20, "y": 166, "width": 560, "height": 56, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "b. evaluation and analytics (its own consent)", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 20, "y": 236, "width": 560, "height": 56, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "c. training or fine-tuning models (clear opt-in only)", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 620, "y": 96, "width": 320, "height": 196, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "honour withdrawal and deletion\nretention covers derived data:\nembeddings and logs, not only\nthe main store\nIndia DPDP: clear notice, consent,\nrights to withdraw and to erasure", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 20, "y": 316, "width": 560, "height": 56, "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeColor": "#868e96", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "not collected by default: full customer PII (redact first)", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 20, "y": 392, "width": 920, "height": 52, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "each use needs its own consent and its own retention rule", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b9", "x": 20, "y": 462, "width": 920, "height": 42, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeColor": "#1971c2", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "support example: sent as is, edited (store the diff), or discarded", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]