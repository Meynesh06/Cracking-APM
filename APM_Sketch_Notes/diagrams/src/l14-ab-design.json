[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Designing a pricing test: six steps", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "the primary metric is revenue per user; guardrails and retention stop a bad win", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 40, "y": 100, "width": 280, "height": 100, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "1 hypothesis\n\"revenue per user up,\nchurn up at most 2 points\"", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 340, "y": 100, "width": 280, "height": 100, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "2 variable\nprice level, framing,\ndiscount, what each tier holds", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 640, "y": 100, "width": 280, "height": 100, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "3 cohort\nnew users, or a random slice;\nno visible comparison", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 40, "y": 250, "width": 280, "height": 100, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "4 metrics\nprimary: revenue per user\nguardrails + retention 30-90 days", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 340, "y": 250, "width": 280, "height": 100, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "5 run a full billing cycle\nannual plans and churn lag\nthe first purchase", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 640, "y": 250, "width": 280, "height": 100, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "6 decide and communicate\nrollback plan, and a plan\nfor existing subscribers", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "arrow", "id": "a9", "x": 322, "y": 150, "width": 16, "height": 0, "points": [[0, 0], [16, 0]], "strokeColor": "#868e96", "strokeWidth": 3, "endArrowhead": "arrow", "startArrowhead": null}, {"type": "arrow", "id": "a10", "x": 622, "y": 150, "width": 16, "height": 0, "points": [[0, 0], [16, 0]], "strokeColor": "#868e96", "strokeWidth": 3, "endArrowhead": "arrow", "startArrowhead": null}, {"type": "arrow", "id": "a11", "x": 780, "y": 202, "width": 600, "height": 46, "points": [[0, 0], [0, 24], [-600, 24], [-600, 46]], "strokeColor": "#868e96", "strokeWidth": 3, "endArrowhead": "arrow", "startArrowhead": null, "roundness": null}, {"type": "arrow", "id": "a12", "x": 322, "y": 300, "width": 16, "height": 0, "points": [[0, 0], [16, 0]], "strokeColor": "#868e96", "strokeWidth": 3, "endArrowhead": "arrow", "startArrowhead": null}, {"type": "arrow", "id": "a13", "x": 622, "y": 300, "width": 16, "height": 0, "points": [[0, 0], [16, 0]], "strokeColor": "#868e96", "strokeWidth": 3, "endArrowhead": "arrow", "startArrowhead": null}, {"type": "rectangle", "id": "b14", "x": 40, "y": 380, "width": 880, "height": 52, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "do not call it on conversion alone: read revenue per user with the guardrails", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t15", "x": 40, "y": 452, "text": "peeking early and stopping on noise is the most common mistake", "fontSize": 16, "fontFamily": 5, "strokeColor": "#e03131", "textAlign": "left"}]