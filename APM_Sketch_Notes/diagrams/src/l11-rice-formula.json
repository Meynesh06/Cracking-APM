[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "RICE: four judgments, one comparable score", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "score = reach x impact x confidence / effort", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 0, "y": 100, "width": 214, "height": 66, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "REACH\nhow many, per quarter", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 0, "y": 180, "width": 214, "height": 130, "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeColor": "#868e96", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "customers or\ntransactions per\nfixed period", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 226, "y": 100, "width": 214, "height": 66, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "IMPACT\nhow much per person", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 226, "y": 180, "width": 214, "height": 130, "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeColor": "#868e96", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "3 = massive\n2 = high\n1 = medium\n0.5 = low\n0.25 = minimal", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 452, "y": 100, "width": 214, "height": 66, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "CONFIDENCE\nhow sure are we?", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b8", "x": 452, "y": 180, "width": 214, "height": 130, "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeColor": "#868e96", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "100% = high\n80% = medium\n50% = low\nunder 50% = moonshot", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b9", "x": 678, "y": 100, "width": 214, "height": 66, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "EFFORT\nteam time, all roles", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b10", "x": 678, "y": 180, "width": 214, "height": 130, "backgroundColor": "#e9ecef", "fillStyle": "solid", "strokeColor": "#868e96", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "person-months across\nproduct, design, eng\n0.5 for tiny work", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b11", "x": 0, "y": 332, "width": 892, "height": 56, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 70, "roundness": {"type": 3}, "label": {"text": "RICE = (Reach x Impact x Confidence) / Effort", "fontSize": 20, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t12", "x": 0, "y": 404, "text": "reach is breadth, impact is depth: do not double-count", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t13", "x": 0, "y": 430, "text": "confidence discounts weak evidence, so the list stays honest", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"},