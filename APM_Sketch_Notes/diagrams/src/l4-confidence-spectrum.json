[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "Confidence signals: from fake precision to honest cues", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "show a signal only when it changes what the user does", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b3", "x": 0, "y": 100, "width": 280, "height": 120, "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeColor": "#e03131", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "raw score: \"92% confident\"\nlooks precise, often misleading\nto users", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b4", "x": 340, "y": 100, "width": 280, "height": 120, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "\"based on 3 sources\"\n\"I could not find this\nin your files\"", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 680, "y": 100, "width": 280, "height": 120, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeColor": "#2f9e44", "strokeWidth": 2, "roughness": 1, "opacity": 40, "roundness": {"type": 3}, "label": {"text": "abstain, or ask a clarifying\nquestion when confidence is low\nrather than guess", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "arrow", "id": "a6", "x": 0, "y": 252, "width": 940, "height": 0, "points": [[0, 0], [940, 0]], "strokeColor": "#e8590c", "strokeWidth": 3, "endArrowhead": "arrow", "startArrowhead": null}, {"type": "text", "id": "t7", "x": 0, "y": 228, "text": "less fake precision, more evidence and honesty", "fontSize": 16, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "rectangle", "id": "b8", "x": 0, "y": 290, "width": 960, "height": 50, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 70, "roundness": {"type": 3}, "label": {"text": "test first: is the score calibrated against eval data?", "fontSize": 17, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "text", "id": "t9", "x": 0, "y": 360, "text": "if it is not calibrated, replace it with evidence cues, or remove it", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t10", "x": 0, "y": 394, "text": "over-trust and under-trust both hurt; the goal is calibrated trust", "fontSize": 16, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}]