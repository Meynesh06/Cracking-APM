[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "CIRCLES for AI: keep the skeleton, add the AI checks", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "general product knowledge, not from the vault sources", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "text", "id": "t3", "x": 0, "y": 84, "text": "standard step", "fontSize": 15, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t4", "x": 130, "y": 84, "text": "the AI addition", "fontSize": 15, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "rectangle", "id": "b5", "x": 0, "y": 108, "width": 120, "height": 46, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "C  Comprehend", "fontSize": 13, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 130, "y": 108, "width": 520, "height": 46, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}}, {"type": "text", "id": "t7", "x": 140, "y": 112, "text": "Is AI the right tool? Deterministic or probabilistic?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t8", "x": 140, "y": 131, "text": "What accuracy and latency are acceptable?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "rectangle", "id": "b9", "x": 0, "y": 160, "width": 120, "height": 46, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "I  Identify", "fontSize": 13, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b10", "x": 130, "y": 160, "width": 520, "height": 46, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}}, {"type": "text", "id": "t11", "x": 140, "y": 164, "text": "Who sees the output, and who is hit by its errors?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t12", "x": 140, "y": 183, "text": "Include the person who reviews or corrects it.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "rectangle", "id": "b13", "x": 0, "y": 212, "width": 120, "height": 46, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "R  Report", "fontSize": 13, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b14", "x": 130, "y": 212, "width": 520, "height": 46, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}}, {"type": "text", "id": "t15", "x": 140, "y": 216, "text": "Add a trust story: rely on the answer without checking.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t16", "x": 140, "y": 235, "text": "Add a failure-state story.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "rectangle", "id": "b17", "x": 0, "y": 264, "width": 120, "height": 46, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "C  Cut", "fontSize": 13, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b18", "x": 130, "y": 264, "width": 520, "height": 46, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}}, {"type": "text", "id": "t19", "x": 140, "y": 268, "text": "Weigh value against data readiness, eval, cost per task.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t20", "x": 140, "y": 287, "text": "No way to measure quality ranks lower.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "rectangle", "id": "b21", "x": 0, "y": 316, "width": 120, "height": 46, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "L  List", "fontSize": 13, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b22", "x": 130, "y": 316, "width": 520, "height": 46, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}}, {"type": "text", "id": "t23", "x": 140, "y": 320, "text": "Automation level: suggestion, copilot or autonomous.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t24", "x": 140, "y": 339, "text": "Include a human-in-the-loop option.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "rectangle", "id": "b25", "x": 0, "y": 368, "width": 120, "height": 46, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "E  Evaluate", "fontSize": 13, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b26", "x": 130, "y": 368, "width": 520, "height": 46, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}}, {"type": "text", "id": "t27", "x": 140, "y": 372, "text": "Add quality distribution, hallucination risk, latency,", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t28", "x": 140, "y": 391, "text": "cost, privacy and fallback behaviour.", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "rectangle", "id": "b29", "x": 0, "y": 420, "width": 120, "height": 46, "backgroundColor": "#d0bfff", "fillStyle": "solid", "strokeColor": "#7048e8", "strokeWidth": 2, "roughness": 1, "opacity": 50, "roundness": {"type": 3}, "label": {"text": "S  Summarize", "fontSize": 13, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b30", "x": 130, "y": 420, "width": 520, "height": 46, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}}, {"type": "text", "id": "t31", "x": 140, "y": 424, "text": "Add the launch plan (staged rollout, kill switch)", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t32", "x": 140, "y": 443, "text": "and the eval plan (golden set, online metrics).", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e", "textAlign": "left"}, {"type": "text", "id": "t33", "x": 670, "y": 84, "text": "three questions for any AI answer", "fontSize": 15, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "rectangle", "id": "b34", "x": 670, "y": 112, "width": 270, "height": 92, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "1. What happens when the\nmodel is wrong, and how does\nthe user recover?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b35", "x": 670, "y": 216, "width": 270, "height": 92, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "2. What data does it need,\nand do we have the right to\nuse it?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b36", "x": 670, "y": 320, "width": 270, "height": 92, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "3. What does it cost per task,\nand does the price fit\nthe value?", "fontSize": 14, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b37", "x": 0, "y": 470, "width": 940, "height": 40, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 35, "roundness": {"type": 3}, "label": {"text": "AI adds quality, data, failure and cost checks", "fontSize": 16, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]