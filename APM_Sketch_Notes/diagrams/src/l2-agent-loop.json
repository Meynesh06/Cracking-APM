[{"type": "text", "id": "t1", "x": 0, "y": 0, "text": "An agent loops: plan, act with a tool, observe, decide", "fontSize": 24, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "text", "id": "t2", "x": 0, "y": 34, "text": "it stops on success, a limit, or a handoff to a person", "fontSize": 17, "fontFamily": 5, "strokeColor": "#868e96", "textAlign": "left"}, {"type": "text", "id": "t3", "x": 100, "y": 84, "text": "the agent loop", "fontSize": 18, "fontFamily": 5, "strokeColor": "#7048e8", "textAlign": "left"}, {"type": "rectangle", "id": "b4", "x": 100, "y": 110, "width": 200, "height": 56, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "plan the next step", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b5", "x": 400, "y": 110, "width": 200, "height": 56, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "act: call a tool", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b6", "x": 400, "y": 230, "width": 200, "height": 56, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "observe the result", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b7", "x": 100, "y": 230, "width": 200, "height": 56, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 55, "roundness": {"type": 3}, "label": {"text": "decide: stop or repeat", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "arrow", "id": "a8", "x": 300, "y": 138, "width": 100, "height": 0, "points": [[0, 0], [100, 0]], "strok