", "id": "b16", "x": 0, "y": 360, "width": 470, "height": 62, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeColor": "#e8590c", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "workflow: the developer fixes the steps in code\nthe LLM fills in each step; cheaper, predictable", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b17", "x": 490, "y": 360, "width": 470, "height": 62, "backgroundColor": "#c3fae8", "fillStyle": "solid", "strokeColor": "#0c8599", "strokeWidth": 2, "roughness": 1, "opacity": 45, "roundness": {"type": 3}, "label": {"text": "agent: the model decides the next step itself\nuse it only when the path cannot be known", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}, {"type": "rectangle", "id": "b18", "x": 0, "y": 436, "width": 960, "height": 56, "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeColor": "#f08c00", "strokeWidth": 2, "roughness": 1, "opacity": 60, "roundness": {"type": 3}, "label": {"text": "per-step accuracy compounds: 0.95 over five steps = 77%\nat 0.90 per step, five steps succeed about 59%", "fontSize": 15, "fontFamily": 5, "strokeColor": "#1e1e1e"}}]