   "isDeleted": false,
   "boundElements": null,
   "updated": 1793728167803,
   "link": null,
   "locked": false,
   "text": "Given I have added a card, when I select \"Save\", then it is in my wallet.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b5",
   "originalText": "Given I have added a card, when I select \"Save\", then it is in my wallet.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
