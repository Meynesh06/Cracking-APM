   "isDeleted": false,
   "boundElements": null,
   "updated": 1793728167803,
   "link": null,
   "locked": false,
   "text": "Given the card is invalid, when I try to save it, then I see an error and nothing is stored.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b7",
   "originalText": "Given the card is invalid, when I try to save it, then I see an error and nothing is stored.",
   "autoResize": true,
   "lineHeight": 1.25
  },
