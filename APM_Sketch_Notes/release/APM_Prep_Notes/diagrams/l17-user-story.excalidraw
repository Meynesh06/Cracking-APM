   "isDeleted": false,
   "boundElements": null,
   "updated": 1793728167803,
   "link": null,
   "locked": false,
   "text": "Given the card is saved, when I open checkout, then it is pre-selected.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b6",
   "originalText": "Given the card is saved, when I open checkout, then it is pre-selected.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
