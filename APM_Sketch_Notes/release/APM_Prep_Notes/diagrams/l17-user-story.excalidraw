   "text": "As a commuter, I want to save a payment card,\nso that I can pay in one tap next time.",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b3",
   "originalText": "As a commuter, I want to save a payment card,\nso that I can pay in one tap next time.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
