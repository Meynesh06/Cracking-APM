   "link": null,
   "locked": false,
   "text": "kill switch\nturns the AI path off, in minutes\nno redeploy\nfalls back to: the old non-AI flow, a cached\nanswer, or \"temporarily unavailable\"\nuse for any incident",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b3",
   "originalText": "kill switch\nturns the AI path off, in minutes\nno redeploy\nfalls back to: the old non-AI flow, a cached\nanswer, or \"temporarily unavailable\"\nuse for any incident",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "IQJ2JSrDBdxIKtGy87gsg",
   "type": "text",
   "x": 549.3676147460938,
