   "boundElements": null,
   "updated": 1793728602431,
   "link": null,
   "locked": false,
   "text": "rollback\nreturns to the previous model, prompt or index\nthe feature stays on\nuse when the new version regressed and\nthe old one was fine",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b4",
   "originalText": "rollback\nreturns to the previous model, prompt or index\nthe feature stays on\nuse when the new version regressed and\nthe old one was fine",
   "autoResize": true,
   "lineHeight": 1.25
  },
