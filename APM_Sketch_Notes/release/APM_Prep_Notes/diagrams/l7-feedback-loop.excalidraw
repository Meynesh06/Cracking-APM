   "index": "aJ",
   "roundness": null,
   "seed": 1221748030,
   "version": 3,
   "versionNonce": 1708127266,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1793728602407,
   "link": null,
   "locked": false,
   "text": "implicit (abundant, noisy)\nedits to an AI draft, copy or accept\nregenerate clicks, abandonment\nescalation to a human",
