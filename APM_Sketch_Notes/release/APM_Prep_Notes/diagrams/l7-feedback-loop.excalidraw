   "boundElements": null,
   "updated": 1793728602407,
   "link": null,
   "locked": false,
   "text": "explicit (sparse, clear)\nthumbs up or down\nreport a problem, star ratings\ncorrections typed by the user",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b10",
   "originalText": "explicit (sparse, clear)\nthumbs up or down\nreport a problem, star ratings\ncorrections typed by the user",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "ifOHV0zHLtsrCl0nerRwh",
   "type": "text",
   "x": 353.91614532470703,
   "y": 226,
   "width": 252.16770935058594,
