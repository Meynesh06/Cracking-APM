  {
   "id": "3bclKv3fEhkQS8-PL_Nqq",
   "type": "text",
   "x": 293.78260803222656,
   "y": 414.875,
   "width": 372.4347839355469,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
